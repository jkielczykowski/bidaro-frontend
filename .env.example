# Copy to web/.env for local development and manual deploys (never commit web/.env).
# In GitHub Actions the same values come from repository secrets — see .github/SECRETS.md.

VITE_SUPABASE_URL=https://<REF>.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Production database for migrations (scripts/migrate.sh, scripts/apply-sql.mjs)
DATABASE_URL=postgresql://postgres.<REF>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres

# SMS OTP (SMSPlanet) — sender: TEST or an approved name
SMSPLANET_API_TOKEN=
SMSPLANET_FROM=TEST

# E-mail via SMTP (Zimbra) — 587 = STARTTLS, 465 = SSL. Without SMTP_HOST (and RESEND_API_KEY) e-mails are marked skipped
# SMTP_HOST=mail.<domain>
# SMTP_PORT=587
# SMTP_USERNAME=noreply@<domain>
# SMTP_PASSWORD=
# MAIL_FROM=Bidigo <noreply@<domain>>

# bidigo-search write endpoints (/index, /webhook, /reindex)
REINDEX_TOKEN=
